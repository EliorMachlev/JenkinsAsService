    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JenkinsAsService</RootNamespace>
    <AssemblyName>JenkinsAsService</AssemblyName>
    <Description>Run Jenkins As Service</Description>
    <Company>EliorMachlev</Company>
    <Copyright>Copyright (c) 2024 All rights reserved</Copyright>
  </PropertyGroup>

  <ItemGroup>
