<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Set via -p:PublishDir=... from the build script after dotnet publish -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\publish\x64\</PublishDir>
    <!-- Custom action DLL location -->
    <CustomActionDir Condition="'$(CustomActionDir)' == ''">..\..\src\JenkinsAsService.CustomActions\bin\Release\net48\</CustomActionDir>
  </PropertyGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <DefineConstants>PublishDir=$(PublishDir);Version=$(Version);CustomActionDir=$(CustomActionDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.*" />
  </ItemGroup>

</Project>
