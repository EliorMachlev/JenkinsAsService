<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include ComponentGuids.wxi ?>

  <Fragment>
    <ComponentGroup Id="PublishOutput" Directory="INSTALLFOLDER">
      <!-- appsettings.json is generated by the WriteConfig custom action, not installed statically -->
    </ComponentGroup>

    <!-- Explicit, stable GUID (it was auto-generated before): InstallLocation.wxs resolves the install folder
         of a previous version by ComponentSearch on this exact value, as the fallback for installs made by a
         version that predates the InstallPath registry key. The value is defined in ComponentGuids.wxi, which
         both files include, so the two sites cannot drift apart. -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER"
               Guid="$(var.JasServiceComponentGuid)">
      <File Id="JenkinsAsService.exe"
            Source="$(var.PublishDir)JenkinsAsService.exe"
            KeyPath="yes" />

      <!-- Least privilege: defaults to the virtual service account 'NT SERVICE\Jenkins'
           (no password, auto-managed SID). Override SERVICE_ACCOUNT (+ SERVICE_PASSWORD for a
           password-based or gMSA account) via the UI or msiexec for domain scenarios. -->
      <ServiceInstall Id="JenkinsServiceInstall"
                      Name="Jenkins"
                      DisplayName="Jenkins Agent Service"
                      Description="Runs a Jenkins inbound (JNLP) agent as a native Windows Service with auto-recovery."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="[SERVICE_ACCOUNT]"
                      Password="[SERVICE_PASSWORD]" />

      <!-- The SCM failure actions are applied by the ConfigureRecovery custom action, not here: neither
           util:ServiceConfig nor the core ServiceConfigFailureActions element is usable. See the .wixproj. -->
      <ServiceControl Id="JenkinsServiceControl"
                      Name="Jenkins"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- Creates the DATA folder: the writable home for agent.jar, logs, the secret file and the agent
         -workDir. The install folder stays read-only under the default Program Files ACL, so a pipeline
         running under the agent identity cannot overwrite the service binary.
         The write grant is applied by the GrantDataAccess custom action, not util:PermissionEx - see the
         .wixproj. Inheritance is left on either way, so the folder keeps its inherited SYSTEM/Admins ACEs. -->
    <Component Id="DataFolderAcl" Directory="DATAFOLDER"
               Guid="$(var.JasDataFolderComponentGuid)">
      <CreateFolder />
    </Component>
  </Fragment>

</Wix>
